cli_path: ~/tod-dt-cli
poll_secs: 10
stall_secs: 900
remote_root: genwork
movies_dir: ~/Movies/generations
use_pty: true
keep_remote: false
download_missing: false
disable_preview: true
offline: false
# Routing: dispatch walks hosts top-to-bottom; a job without --host goes to
# the first enabled host with free capacity. List order = preference order.
# Per-host cli_path overrides the global cli_path above (different binary or
# version per machine); conn_type / models_dir / idle_policy are per-host too.
hosts:
  # example remote render host — pre-disabled. Fill in dest / models_dir and
  # change enabled to true when you actually use this host. While it stays
  # disabled, jobs without --host go to the local host below.
  - alias: ltx-a
    dest: user@192.168.0.10
    max_jobs: 1
    enabled: false
    # cli_path: ~/tod-dt-cli   # uncomment to use a different binary on ltx-a
    models_dir: /path/to/models
    # idle consumer: local workload on the render host takes precedence
    idle_policy:
      enabled: false
      max_load: 8.0          # skip dispatch when 1-min load exceeds this
      heavy_processes:       # or when any of these run on the host
        - Premiere
        - After Effects
        - Media Encoder
        - DaVinci
        - Resolve
        - Blender
      pause_release_secs: 300  # busy this long -> serve-stop to free model RAM
  # this machine, no ssh. A full peer of ssh hosts: conn_type: local swaps the
  # transport (local shell + file copies instead of ssh/rsync) but everything
  # else — probe, dispatch, oneshot/serve backends, idle policy, cancel,
  # collection — is identical. Pre-enabled so a fresh copy generates locally
  # out of the box; set enabled: false if this machine should not generate
  # (limited hardware — it still works for testing queue/UI/transport).
  - alias: local
    conn_type: local
    dest: local
    max_jobs: 1
    enabled: true